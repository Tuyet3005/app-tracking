{
  "name": "app-tracking",
  "type": "module",
  "version": "1.0.0",
  "description": "Simple Node app that echoes input text",
  "main": "server.js",
  "scripts": {
    "build": "tsc && copyfiles ./public/* ./dist",
    "start": "node server.js",
    "dev": "tsx watch server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@tigrisdata/storage": "^2.12.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  }
}
